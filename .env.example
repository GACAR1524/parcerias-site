# Copie para .env e ajuste. Nunca envie o .env para repositórios públicos.

# Porta interna do servidor Node (o Caddy faz o HTTPS na frente)
PORT=3000

# Segredo que assina os cookies de sessão. Gere um valor longo e aleatório:
#   openssl rand -hex 48
JWT_SECRET=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres

# Caminho do arquivo do banco SQLite (no Docker é /data/parcerias.db, dentro do volume)
DB_PATH=./data/parcerias.db

# Dias que a sessão "manter conectado" dura
SESSION_DAYS=30

# Cookies só por HTTPS (true em produção). Use false apenas para testar em http://localhost
COOKIE_SECURE=true

# Quantos proxies existem na frente (1 = Caddy/Nginx). Necessário para o limite de tentativas de login por IP.
TRUST_PROXY=1

# Domínio usado pelo Caddy para emitir o certificado HTTPS automaticamente (docker-compose)
DOMAIN=parcerias.seudominio.com.br

# Pasta dos backups (npm run backup)
BACKUP_DIR=./backups
